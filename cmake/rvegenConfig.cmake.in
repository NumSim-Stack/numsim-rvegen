@PACKAGE_INIT@

# rvegen — Representative Volume Element generator (header-only, C++23).
#
# Re-resolves transitive dependencies that rvegen's INTERFACE target
# links against, so downstream `find_package(rvegen)` doesn't require
# the consumer to call `find_package(Eigen3)` / `find_package(Boost)`
# themselves.
#
# numsim-core (>= 1.3) is re-found below when rvegen was built against its
# CMake package; otherwise the consumer must put numsim-core's include
# path on the compiler search path themselves.

include(CMakeFindDependencyMacro)

find_dependency(Boost)
find_dependency(Eigen3)
find_dependency(nlohmann_json)

# numsim-core: if rvegen was built against numsim-core's CMake package its
# exported target links numsim-core::numsim-core, so it is required here.
# Otherwise rvegen used a sibling include path and consumers must provide
# numsim-core's headers themselves.
if(@RVEGEN_NUMSIM_CORE_FROM_PACKAGE@)
  find_dependency(numsim-core 1.3 CONFIG)
else()
  find_package(numsim-core CONFIG QUIET)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/rvegenTargets.cmake")

check_required_components(rvegen)
