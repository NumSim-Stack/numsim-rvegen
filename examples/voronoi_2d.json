{
  "_comment": "2D Voronoi polycrystal. Deterministic generator: seeds come from n_seeds + seed; the termination section is not needed.",

  "domain_box": [1.0, 1.0, 0.0],

  "generator": { "type": "voronoi_2d", "n_seeds": 24, "seed": 7 },

  "postprocess": [
    { "type": "svg", "canvas_width": 600.0, "output_path": "voronoi_2d.svg" },
    { "type": "voxel", "nx": 96, "ny": 96, "nz": 1,
      "output_path": "voronoi_2d.vox" }
  ]
}
