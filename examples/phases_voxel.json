{
  "_comment": "Phases + phase_assignment. Circles become 'fibre' and rectangles 'filler' (by_shape_type); cells no shape covers belong to the declared matrix phase and carry its id (id 0 would mean an untagged shape). The voxel grid and the VTK file carry the phase ids, and each writes a <output>.phases.json name table next to it; materials are assigned downstream by phase name or id.",

  "domain_box": [1.0, 1.0, 0.0],
  "seed": 42,

  "distributions": {
    "uniform_x": { "type": "uniform_real", "a": 0.08, "b": 0.92 },
    "uniform_y": { "type": "uniform_real", "a": 0.08, "b": 0.92 },
    "circle_r":  { "type": "uniform_real", "a": 0.04, "b": 0.06 },
    "rect_w":    { "type": "uniform_real", "a": 0.06, "b": 0.10 },
    "rect_h":    { "type": "uniform_real", "a": 0.04, "b": 0.07 }
  },

  "shapes": [
    { "type": "circle_input",
      "pos_x_dist": "uniform_x", "pos_y_dist": "uniform_y",
      "radius_dist": "circle_r" },
    { "type": "rectangle_input",
      "pos_x_dist": "uniform_x", "pos_y_dist": "uniform_y",
      "width_dist": "rect_w", "height_dist": "rect_h" }
  ],

  "phases": [
    { "name": "matrix" },
    { "name": "fibre" },
    { "name": "filler" }
  ],

  "phase_assignment": {
    "matrix": "matrix",
    "by_shape_type": { "circle": "fibre", "rectangle": "filler" }
  },

  "generator":   { "type": "only_inside", "max_attempts": 500000 },
  "termination": { "type": "number_of_inclusions", "target": 12 },

  "postprocess": [
    { "type": "voxel", "nx": 192, "ny": 192, "nz": 1,
      "output_path": "phases_voxel.vox" },
    { "type": "vtk_legacy", "nx": 192, "ny": 192, "nz": 1,
      "output_path": "phases_voxel.vtk" }
  ]
}
