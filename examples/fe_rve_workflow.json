{
  "_comment": "Periodic 2D circle pack at 20 % as a gmsh geometry with the options a finite-element mesh usually needs: periodic curve constraints, element sizes, quadratic elements, Frontal-Delaunay meshing (algorithm 6; algorithm 8 crashes gmsh 4.12 when periodic constraints are present) and recombination into quads. The phases declared here become physical groups in the .geo: Physical Surface(\"fibre\") for the circles and Physical Surface(\"matrix\") for the rest.",
  "domain_box": [
    1.0,
    1.0,
    0.0
  ],
  "seed": 13,
  "distributions": {
    "any_x": {
      "type": "uniform_real",
      "a": 0.0,
      "b": 1.0
    },
    "any_y": {
      "type": "uniform_real",
      "a": 0.0,
      "b": 1.0
    },
    "uniform_radius": {
      "type": "uniform_real",
      "a": 0.04,
      "b": 0.06
    }
  },
  "shapes": [
    {
      "type": "circle_input",
      "pos_x_dist": "any_x",
      "pos_y_dist": "any_y",
      "radius_dist": "uniform_radius",
      "phase_name": "fibre"
    }
  ],
  "phases": [
    {
      "name": "matrix"
    },
    {
      "name": "fibre"
    }
  ],
  "phase_assignment": {
    "matrix": "matrix"
  },
  "generator": {
    "type": "periodic",
    "max_attempts": 200000
  },
  "termination": {
    "type": "volume_fraction",
    "target_fraction": 0.2
  },
  "postprocess": [
    {
      "type": "gmsh_geo",
      "output_path": "fe_rve_workflow.geo",
      "periodic": true,
      "char_length_min": 0.005,
      "char_length_max": 0.015,
      "element_order": 2,
      "algorithm": 6,
      "recombine_quads": true
    }
  ]
}
